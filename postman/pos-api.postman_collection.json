    {
      "name": "Stores",
      "item": [
        {
          "name": "List accessible stores",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/stores",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "stores"
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Products",
      "item": [
        {
          "name": "List products",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/products",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "products"
              ]
            }
          }
        },
        {
          "name": "Get product",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/products/{{beansId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "products",
                "{{beansId}}"
              ]
            }
          }
        },
        {
          "name": "Create product (owner)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/products",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "products"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"sku\": \"SYR-VAN\",\n  \"name\": \"Vanilla Syrup\",\n  \"priceCents\": 54900\n}"
            }
          }
        },
        {
          "name": "Update product (owner)",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/products/{{beansId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "products",
                "{{beansId}}"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"priceCents\": 134900\n}"
            }
          }
        }
      ]
    },
    {
      "name": "Inventory",
      "item": [
        {
          "name": "List store inventory",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/stores/{{storeA1}}/inventory",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "stores",
                "{{storeA1}}",
                "inventory"
              ]
            }
          }
        },
        {
          "name": "Set stock (owner or manager)",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/stores/{{storeA1}}/inventory/{{beansId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "stores",
                "{{storeA1}}",
                "inventory",
                "{{beansId}}"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"quantity\": 40\n}"
            }
          }
        },
        {
          "name": "Adjust stock (owner or manager)",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/stores/{{storeA1}}/inventory/{{beansId}}/adjust",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "stores",
                "{{storeA1}}",
                "inventory",
                "{{beansId}}",
                "adjust"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"delta\": -3\n}"
            }
          }
        }
      ]
    },
    {
      "name": "Sales",
      "item": [
        {
          "name": "Create sale",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Idempotency-Key",
                "value": "{{$guid}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/stores/{{storeA1}}/sales",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "stores",
                "{{storeA1}}",
                "sales"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"items\": [\n    {\n      \"productId\": \"{{beansId}}\",\n      \"quantity\": 2\n    },\n    {\n      \"productId\": \"{{filtersId}}\",\n      \"quantity\": 1\n    }\n  ]\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const body = pm.response.json();",
                  "if (body.id) { pm.collectionVariables.set('saleId', body.id); }"
                ]
              }
            }
          ]
        },
        {
          "name": "Create sale with fixed key (retry to see replay)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Idempotency-Key",
                "value": "{{idempotencyKey}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/stores/{{storeA1}}/sales",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "stores",
                "{{storeA1}}",
                "sales"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"items\": [\n    {\n      \"productId\": \"{{beansId}}\",\n      \"quantity\": 2\n    },\n    {\n      \"productId\": \"{{filtersId}}\",\n      \"quantity\": 1\n    }\n  ]\n}"
            }
          }
        },
        {
          "name": "Create sale with failed payment",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Idempotency-Key",
                "value": "{{$guid}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/stores/{{storeA1}}/sales",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "stores",
                "{{storeA1}}",
                "sales"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"items\": [\n    {\n      \"productId\": \"{{beansId}}\",\n      \"quantity\": 1\n    }\n  ],\n  \"paymentOutcome\": \"FAILED\"\n}"
            }
          }
        },
        {
          "name": "Create sale exceeding stock",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Idempotency-Key",
                "value": "{{$guid}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/stores/{{storeA1}}/sales",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "stores",
                "{{storeA1}}",
                "sales"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"items\": [\n    {\n      \"productId\": \"{{grinderId}}\",\n      \"quantity\": 500\n    }\n  ]\n}"
            }
          }
        },
        {
          "name": "List sales",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/stores/{{storeA1}}/sales?page=1&limit=20",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "stores",
                "{{storeA1}}",
                "sales?page=1&limit=20"
              ]
            }
          }
        },
        {
          "name": "Get sale",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/stores/{{storeA1}}/sales/{{saleId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "stores",
                "{{storeA1}}",
                "sales",
                "{{saleId}}"
              ]
            }
          }
        }
      ]
