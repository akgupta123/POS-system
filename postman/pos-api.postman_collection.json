{
  "info": {
    "name": "POS API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{token}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000"
    },
    {
      "key": "token",
      "value": ""
    },
    {
      "key": "idempotencyKey",
      "value": "pos-terminal-1-order-0001"
    },
    {
      "key": "storeA1",
      "value": "20000000-0000-4000-8000-000000000001"
    },
    {
      "key": "storeA2",
      "value": "20000000-0000-4000-8000-000000000002"
    },
    {
      "key": "storeB1",
      "value": "20000000-0000-4000-8000-000000000003"
    },
    {
      "key": "beansId",
      "value": "30000000-0000-4000-8000-000000000001"
    },
    {
      "key": "filtersId",
      "value": "30000000-0000-4000-8000-000000000002"
    },
    {
      "key": "grinderId",
      "value": "30000000-0000-4000-8000-000000000003"
    },
    {
      "key": "notebookId",
      "value": "30000000-0000-4000-8000-000000000005"
    },
    {
      "key": "saleId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Login as owner (merchant A)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "login"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"owner.a@acme.test\",\n  \"password\": \"Password@123\"\n}"
            },
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const body = pm.response.json();",
                  "if (body.accessToken) { pm.collectionVariables.set('token', body.accessToken); }"
                ]
              }
            }
          ]
        },
        {
          "name": "Login as manager (store A1)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
