            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"manager.a1@acme.test\",\n  \"password\": \"Password@123\"\n}"
            },
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const body = pm.response.json();",
                  "if (body.accessToken) { pm.collectionVariables.set('token', body.accessToken); }"
                ]
              }
            }
          ]
        },
